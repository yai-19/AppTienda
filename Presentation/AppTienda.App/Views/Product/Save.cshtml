@model SaveProductDto
@{
    bool isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Editar Producto" : "Nuevo Producto";
    var categories = ViewBag.Categories as SelectList;
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-7">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h3 class="fw-bold mb-0 text-dark">@(isEdit ? "Editar Producto" : "Nuevo Producto")</h3>
            <a asp-action="Index" class="btn btn-outline-mocha btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Volver
            </a>
        </div>

        <div class="card-custom">
            <form asp-action="@(isEdit ? "Edit" : "Create")" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ImageUrl" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-7">
                        <label asp-for="Name" class="form-label fw-bold">Nombre del Producto <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="Ej. Camisa Lino Beige" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-5">
                        <label asp-for="CategoryId" class="form-label fw-bold">Categoría <span class="text-danger">*</span></label>
                        <select asp-for="CategoryId" class="form-select" asp-items="categories">
                            <option value="">-- Seleccionar --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-bold">Descripción (Opcional)</label>
                    <textarea asp-for="Description" class="form-control" rows="2" placeholder="Detalles o notas del producto..."></textarea>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-4">
                        <label asp-for="Sku" class="form-label fw-bold">Código SKU (Opcional)</label>
                        <input asp-for="Sku" class="form-control" placeholder="Ej. CAM-01" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label asp-for="PurchasePrice" class="form-label fw-bold">Costo Compra ($) <span class="text-danger">*</span></label>
                        <input asp-for="PurchasePrice" class="form-control" type="number" step="0.01" id="costInput" placeholder="0.00" />
                        <span asp-validation-for="PurchasePrice" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-4">
                        <label asp-for="SalePrice" class="form-label fw-bold">Precio Venta ($) <span class="text-danger">*</span></label>
                        <input asp-for="SalePrice" class="form-control" type="number" step="0.01" id="priceInput" placeholder="0.00" />
                        <span asp-validation-for="SalePrice" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Live Profit Calc Box -->
                <div class="p-3 mb-3 rounded-3" style="background-color: var(--color-warm-light); border: 1.5px dashed var(--color-mocha);">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold" style="color: var(--color-mocha);"><i class="bi bi-calculator me-1"></i> Ganancia por unidad:</span>
                        <span id="profitPreview" class="fw-extrabold fs-5 text-success">+$0.00</span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <label asp-for="Stock" class="form-label fw-bold">Stock Inicial <span class="text-danger">*</span></label>
                        <input asp-for="Stock" class="form-control" type="number" min="0" />
                        <span asp-validation-for="Stock" class="text-danger small"></span>
                    </div>
                    <div class="col-6">
                        <label asp-for="Status" class="form-label fw-bold">Estado</label>
                        <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<ProductStatus>()"></select>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="ImageFile" class="form-label fw-bold">Foto (Opcional)</label>
                    <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
                    @if (isEdit && !string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <div class="mt-2">
                            <img src="@Model.ImageUrl" alt="Foto actual" class="rounded border" style="width: 50px; height: 50px; object-fit: cover;" />
                        </div>
                    }
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-light">Cancelar</a>
                    <button type="submit" class="btn btn-wine px-4">
                        <i class="bi bi-save me-1"></i> Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function updateCalc() {
        const cost = parseFloat(document.getElementById('costInput').value) || 0;
        const price = parseFloat(document.getElementById('priceInput').value) || 0;
        const profit = price - cost;
        const profitElem = document.getElementById('profitPreview');
        profitElem.innerText = (profit >= 0 ? '+' : '') + '$' + profit.toFixed(2);
        profitElem.className = profit >= 0 ? 'fw-extrabold fs-5 text-success' : 'fw-extrabold fs-5 text-danger';
    }
    document.getElementById('costInput').addEventListener('input', updateCalc);
    document.getElementById('priceInput').addEventListener('input', updateCalc);
    updateCalc();
</script>
}
