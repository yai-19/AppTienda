@model SaveCategoryDto
@{
    bool isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Editar Categoría" : "Nueva Categoría";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-6">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h3 class="fw-bold mb-0 text-dark">@(isEdit ? "Editar Categoría" : "Nueva Categoría")</h3>
            <a asp-action="Index" class="btn btn-outline-mocha btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Volver
            </a>
        </div>

        <div class="card-custom">
            <form asp-action="@(isEdit ? "Edit" : "Create")" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-bold">Nombre <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control" placeholder="Ej. Ropa, Calzado, Perfumes..." />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label fw-bold">Descripción (Opcional)</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Detalles de la categoría..."></textarea>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-light">Cancelar</a>
                    <button type="submit" class="btn btn-wine px-4">
                        <i class="bi bi-save me-1"></i> Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
