@model Microsoft.AspNetCore.Diagnostics.IExceptionHandlerPathFeature
@{
    ViewData["Title"] = "Error";
}

<div class="card p-5 text-center my-5">
    <i class="bi bi-exclamation-triangle-fill text-danger display-1 mb-3"></i>
    <h2 class="fw-bold text-dark">Ha ocurrido un error inesperado</h2>
    <p class="text-muted">Por favor, vuelve al inicio o contacta al administrador.</p>
    <div class="mt-3">
        <a asp-controller="Home" asp-action="Index" class="btn btn-custom-primary">
            <i class="bi bi-house me-1"></i> Ir al Inicio
        </a>
    </div>
</div>
