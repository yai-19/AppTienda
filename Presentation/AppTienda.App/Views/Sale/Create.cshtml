@model SaveSaleDto
@{
    ViewData["Title"] = "Registrar Venta";
    var products = ViewBag.Products as SelectList;
    var productsList = ViewBag.ProductsList as List<ProductDto> ?? new List<ProductDto>();
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-6">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h3 class="fw-bold mb-0 text-dark">Registrar Venta</h3>
            <a asp-action="Index" class="btn btn-outline-mocha btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Volver
            </a>
        </div>

        <div class="card-custom">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="ProductId" class="form-label fw-bold">Producto Vendido <span class="text-danger">*</span></label>
                    <select asp-for="ProductId" class="form-select form-select-lg" id="productSelect" asp-items="products">
                        <option value="">-- Selecciona el producto --</option>
                    </select>
                    <span asp-validation-for="ProductId" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="SaleDate" class="form-label fw-bold">Fecha y Hora <span class="text-danger">*</span></label>
                        <input asp-for="SaleDate" class="form-control" type="datetime-local" value="@Model.SaleDate.ToString("yyyy-MM-ddTHH:mm")" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Quantity" class="form-label fw-bold">Cantidad <span class="text-danger">*</span></label>
                        <input asp-for="Quantity" class="form-control" type="number" min="1" id="qtyInput" />
                        <small id="stockLabel" class="text-muted d-block mt-1">Stock disponible: -</small>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="UnitPrice" class="form-label fw-bold">Precio de Venta ($) <span class="text-danger">*</span></label>
                        <input asp-for="UnitPrice" class="form-control" type="number" step="0.01" id="unitPriceInput" placeholder="0.00" />
                        <small class="text-muted">Costo unitario de compra: <span id="unitCostSpan">$0.00</span></small>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="PaymentMethod" class="form-label fw-bold">Método de Pago</label>
                        <select asp-for="PaymentMethod" class="form-select" asp-items="Html.GetEnumSelectList<PaymentMethod>()"></select>
                    </div>
                </div>

                <!-- Profit Live Box -->
                <div class="p-3 mb-3 rounded-3" style="background-color: var(--color-warm-light); border: 1.5px dashed var(--color-mocha);">
                    <div class="row text-center">
                        <div class="col-6 border-end">
                            <small class="text-muted d-block fw-bold">Total Venta</small>
                            <span id="totalAmountText" class="fw-extrabold fs-5" style="color: var(--color-wine);">$0.00</span>
                        </div>
                        <div class="col-6">
                            <small class="text-muted d-block fw-bold">Ganancia Neta</small>
                            <span id="profitText" class="fw-extrabold fs-5 text-success">+$0.00</span>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-12 col-md-6">
                        <label asp-for="CustomerName" class="form-label fw-bold">Cliente (Opcional)</label>
                        <input asp-for="CustomerName" class="form-control" placeholder="Ej. Ana Torres" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Notes" class="form-label fw-bold">Nota (Opcional)</label>
                        <input asp-for="Notes" class="form-control" placeholder="Comentarios..." />
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-light">Cancelar</a>
                    <button type="submit" class="btn btn-wine px-4 fw-bold">
                        <i class="bi bi-cart-check me-1"></i> Guardar Venta
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const products = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(productsList.Select(p => new {
        id = p.Id,
        name = p.Name,
        salePrice = p.SalePrice,
        purchasePrice = p.PurchasePrice,
        stock = p.Stock
    })));

    const select = document.getElementById('productSelect');
    const qty = document.getElementById('qtyInput');
    const price = document.getElementById('unitPriceInput');
    const stockLabel = document.getElementById('stockLabel');
    const unitCostSpan = document.getElementById('unitCostSpan');
    const totalAmountText = document.getElementById('totalAmountText');
    const profitText = document.getElementById('profitText');

    function onProdChange() {
        const id = parseInt(select.value);
        const item = products.find(x => x.id === id);
        if (item) {
            price.value = item.salePrice;
            stockLabel.innerText = 'Stock disponible: ' + item.stock + ' unidades';
            unitCostSpan.innerText = '$' + item.purchasePrice.toFixed(2);
        } else {
            stockLabel.innerText = 'Stock disponible: -';
            unitCostSpan.innerText = '$0.00';
        }
        recalculate();
    }

    function recalculate() {
        const id = parseInt(select.value);
        const item = products.find(x => x.id === id);
        const q = parseInt(qty.value) || 0;
        const p = parseFloat(price.value) || 0;
        const cost = item ? item.purchasePrice : 0;

        const total = p * q;
        const profit = total - (cost * q);

        totalAmountText.innerText = '$' + total.toFixed(2);
        profitText.innerText = (profit >= 0 ? '+' : '') + '$' + profit.toFixed(2);
        profitText.className = profit >= 0 ? 'fw-extrabold fs-5 text-success' : 'fw-extrabold fs-5 text-danger';
    }

    select.addEventListener('change', onProdChange);
    qty.addEventListener('input', recalculate);
    price.addEventListener('input', recalculate);

    if (select.value) onProdChange();
</script>
}
