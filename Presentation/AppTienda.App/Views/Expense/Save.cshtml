@model SaveExpenseDto
@{
    bool isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Editar Gasto" : "Registrar Gasto";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-6">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h3 class="fw-bold mb-0 text-dark">@(isEdit ? "Editar Gasto" : "Nuevo Gasto")</h3>
            <a asp-action="Index" class="btn btn-outline-mocha btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Volver
            </a>
        </div>

        <div class="card-custom">
            <form asp-action="@(isEdit ? "Edit" : "Create")" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="ExpenseDate" class="form-label fw-bold">Fecha <span class="text-danger">*</span></label>
                        <input asp-for="ExpenseDate" class="form-control" type="date" value="@Model.ExpenseDate.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Category" class="form-label fw-bold">Categoría de Gasto</label>
                        <select asp-for="Category" class="form-select" asp-items="Html.GetEnumSelectList<ExpenseCategory>()"></select>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-bold">Descripción <span class="text-danger">*</span></label>
                    <input asp-for="Description" class="form-control" placeholder="Ej. Pago de luz mensual" />
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Amount" class="form-label fw-bold">Monto del Gasto ($) <span class="text-danger">*</span></label>
                    <input asp-for="Amount" class="form-control form-control-lg" type="number" step="0.01" placeholder="0.00" />
                    <span asp-validation-for="Amount" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Notes" class="form-label fw-bold">Notas (Opcional)</label>
                    <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Factura, recibo o comprobante..."></textarea>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-light">Cancelar</a>
                    <button type="submit" class="btn btn-wine px-4">
                        <i class="bi bi-save me-1"></i> Guardar Gasto
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
